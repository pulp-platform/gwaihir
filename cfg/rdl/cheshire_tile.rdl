`ifndef __CHESHIRE_TILE_RDL__
`define __CHESHIRE_TILE_RDL__

// `include "serial_link_single_channel.rdl"
`include "cheshire.rdl"
`include "fll.rdl"
`include "gw_chip_regs.rdl"
`include "gw_hyperbus_regs.rdl"
`include "lpddr.rdl"

addrmap cheshire_tile #(longint unsigned SlinkNumLanes = 8) {
    cheshire #(.SlinkNumLanes(SlinkNumLanes)) cheshire @ 0x0000_0000;

`ifdef GW_CHIP_RDL
    fll          fll[2]       @ 0x1800_1000 += 0x0000_0010;
    gw_chip_regs gw_chip_regs @ 0x1800_2000;
`endif
    gw_hyperbus_regs gw_hyperbus_regs @ 0x1800_3000;

    // HyperBus IP control registers: no SystemRDL description, exposed as memory
    external mem {
        mementries = 0x1000 / 4;
        memwidth = 32;
    } gw_hyperbus_ctrl @ 0x1800_4000;
};

`endif // __CHESHIRE_TILE_RDL__
