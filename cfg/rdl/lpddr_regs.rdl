`ifndef LPDDR_TOP_WRAP_RDL
`define LPDDR_TOP_WRAP_RDL

addrmap lpddr_regs {

    default regwidth = 32;
    default sw = rw;
    default hw = r;

    reg core_ddrc {
        field {
            desc = "reset signal for UMCTL CORE.";
        } rst_n[0:0] = 0x0;
    };

    reg rst {
        field {
            desc = "SW reset signal";
        } rst_n[0:0] = 0x0;
    };

    reg sram {
        field {
            desc = "SRAM impl control";
        } impl[14:0] = 0x0;
    };

    core_ddrc core_ddrc;
    rst apb;
    rst axi;
    rst pwr_ok_in;
    sram rdata_ram;
    sram wdata_ram;
    sram iccm_ram;
    sram dccm_ram;
};

`endif // LPDDR_TOP_WRAP_RDL
