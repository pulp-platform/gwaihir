`ifndef __UCIE_RDL__
`define __UCIE_RDL__

addrmap ucie {
    // UCIe die-to-die interface - no register map defined; access via base pointer
    external mem {
        mementries = 1; memwidth = 32;
    } data @0x0;
};

`endif // __UCIE_RDL__
